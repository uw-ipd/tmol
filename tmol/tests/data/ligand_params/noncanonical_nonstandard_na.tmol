    display_name: na5primephos
    pattern: '[{down}]P(O)(O)OCC'
    remove_atoms: ['<{down}>', <O1>, <O2>]
    add_atoms: [{name: OP3, atom_type: OG3}, {name: OP2, atom_type: OG3}, {name: OP1,
        atom_type: OG2}]
    add_atom_aliases: [{name: OP3, alt_name: O3P}]
    add_bonds: [[<P1>, OP3, SINGLE, false], [<P1>, OP2, SINGLE, false], [<P1>, OP1,
        SINGLE, false]]
    icoors: [{name: OP3, source: null, phi: -1.0517179539592632, theta: 1.3268815547337358,
        d: 1.607355, parent: <P1>, grand_parent: <O3>, great_grand_parent: <C1>},
      {name: OP2, source: null, phi: -1.9942912719061625, theta: 1.254933829525481,
        d: 1.485499, parent: <P1>, grand_parent: <O3>, great_grand_parent: OP3}, {
        name: OP1, source: null, phi: -2.284283015472654, theta: 1.250909396976355,
        d: 1.484918, parent: <P1>, grand_parent: <O3>, great_grand_parent: OP2}]
    applies_to:
      backbone_types: null
      base_names:
      - TTD
  - name: TTD_NaFivePrime
    display_name: na5prime
    pattern: '[{down}]P(O)(O)OCC'
    remove_atoms: ['<{down}>', <P1>, <O1>, <O2>]
    add_atoms: [{name: HO5', atom_type: HO}]
    modify_atoms: [{name: <O3>, atom_type: Ohx}]
    add_bonds: [[<O3>, HO5', SINGLE, false]]
    icoors: [{name: HO5', source: null, phi: 3.139680505767893, theta: 1.2301072888607325,
        d: 1.000437, parent: <O3>, grand_parent: <C1>, great_grand_parent: <C2>}]
    add_torsions:
    - name: chi1
      a:
        atom: <C2>
        connection: null
        bond_sep_from_conn: null
      b:
        atom: <C1>
        connection: null
        bond_sep_from_conn: null
      c:
        atom: <O3>
        connection: null
        bond_sep_from_conn: null
      d:
        atom: HO5'
        connection: null
        bond_sep_from_conn: null
    add_chi_samples:
    - chi_dihedral: chi1
      samples:
      - 60.0
      - -60.0
      - 180.0
      expansions:
      - 20.0
      is_proton: true
    applies_to:
      backbone_types: null
      base_names:
      - TTD
  - name: TTD_NaThreePrime
    display_name: na3prime
    pattern: COCCO[{up}]
    remove_atoms: ['<{up}>']
    add_atoms: [{name: HO3', atom_type: HO}]
    modify_atoms: [{name: <O2>, atom_type: Ohx}]
    add_bonds: [[<O2>, HO3', SINGLE, false]]
    icoors: [{name: HO3', source: null, phi: 3.141592653589793, theta: 1.2301072888607325,
        d: 1.000437, parent: <O2>, grand_parent: <C3>, great_grand_parent: <C2>}]
    add_torsions:
    - name: chi2
      a:
        atom: <C2>
        connection: null
        bond_sep_from_conn: null
      b:
        atom: <C3>
        connection: null
        bond_sep_from_conn: null
      c:
        atom: <O2>
        connection: null
        bond_sep_from_conn: null
      d:
        atom: HO3'
        connection: null
        bond_sep_from_conn: null
    add_chi_samples:
    - chi_dihedral: chi2
      samples:
      - 60.0
      - -60.0
      - 180.0
      expansions:
      - 20.0
      is_proton: true
    applies_to:
      backbone_types: null
      base_names:
      - TTD
  atom_type_elements:
    CS1: C
    CS2: C
    CSp: C
    OG3: O
    PG3: P
    OG2: O
    CS3: C
    Oet: O
    Nad3: N
    CDp: C
    Oad: O
    Nad: N
    CSQ: C
    HC: H
    HN: H
