  adds_patches:
  - name: HMR_CarboxyTerminus
    display_name: cterm
    pattern: '[*][*]C(=O)[{up}]'
    remove_atoms: ['<{up}>', <O1>]
    add_atoms: [{name: O, atom_type: Oat}, {name: OXT, atom_type: Oat}]
    add_bonds: [[<C1>, OXT, AROMATIC, false], [<C1>, O, AROMATIC, false]]
    icoors: [{name: O, source: <O1>, phi: 1.3962634015954636, theta: 1.0471975511965976,
        d: 1.2, parent: <C1>, grand_parent: <*2>, great_grand_parent: <*1>}, {name: OXT,
        source: <O1>, phi: -3.141592653589793, theta: 1.0471975511965976, d: 1.2,
        parent: <C1>, grand_parent: <*2>, great_grand_parent: O}]
    applies_to:
      backbone_types: null
      base_names:
      - HMR
  - name: HMR_AminoTerminus
    display_name: nterm
    pattern: '[*][*][NH][{down}]'
    remove_atoms: ['<{down}>', <H1>]
