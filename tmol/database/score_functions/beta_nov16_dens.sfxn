# beta_nov16_dens: beta2016 (beta_nov2016_cart) plus the elec_dens_fast fit-to-density term and nothing else. Every other
# weight is beta2016's. The density weight 35 is the value Rosetta's cryo-EM refinement script
# (rosetta_scripts/public/cryoem/cryoem_glycan_refinement.xml) uses; that script also reweights fa_rep and the bonded terms
# on top of its base weights, which a caller does with ScoreFunction.set_weight.
#
# The observed map is a score-function option (density_map, density_resolution); see tmol.score.density.
version: "1.0"
weights:
  fa_ljatr: 1.0
  fa_ljrep: 0.55
  fa_lk: 1.0
  fa_elec: 1.0
  hbond: 1.0
  lk_ball_iso: -0.38
  lk_ball: 0.92
  lk_bridge: -0.33
  lk_bridge_uncpl: -0.33
  omega: 0.48
  rama: 0.50
  disulfide: 1.25
  cart_lengths: 0.5
  cart_angles: 0.5
  cart_torsions: 0.5
  cart_impropers: 0.5
  cart_hxltorsions: 0.5
  dunbrack_rot: 0.76
  dunbrack_rotdev: 0.69
  dunbrack_semirot: 0.78
  ref: 1.0
  gen_torsions: 1.0
  na_torsion: 1.0
  na_torsion_well: 1.0
  elec_dens_fast: 35.0
