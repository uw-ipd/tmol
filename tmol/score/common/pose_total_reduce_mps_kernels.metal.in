// Metal entry point for the pose-total reduction.
//
// Pre-expanded by the C preprocessor at build time and compiled at runtime;
// see cmake/TmolMetalShader.cmake. The reduction itself lives in
// pose_total_reduce_kernels.hh, compiled here from the same source the CPU and
// CUDA backends use.

#include <tmol/score/common/device_operations.mps.impl.hh>
#include <tmol/score/common/launch_box_macros.hh>
#include <tmol/score/common/pose_total_reduce_ctx_metal.hh>
#include <tmol/score/common/pose_total_reduce_kernels.hh>

using tmol::score::common::DeviceOperations;
using tmol::score::common::PoseTotalReduceCtxMetal;
using tmol::score::common::PoseTotalReduceShared;
using tmol::score::common::WorkgroupLane;
using tmol::score::common::pose_total_reduce_body;

LAUNCH_BOX_32

typedef WorkgroupLane<tmol::Device::MPS> Lane;
typedef PoseTotalReduceCtxMetal<float> Ctx;
typedef PoseTotalReduceShared<float, launch_t::sm_ptx::nt> Shared;

#define TMOL_N_SIMDS ((launch_t::sm_ptx::nt + 31) / 32)

kernel void pose_total_reduce_f32(
    device const int64_t* meta [[buffer(0)]],
    device void* b1 [[buffer(1)]],
    device void* b2 [[buffer(2)]],
    uint cta [[threadgroup_position_in_grid]],
    uint tid [[thread_position_in_threadgroup]],
    uint n_threads [[threads_per_threadgroup]]) {
  static_assert(
      Ctx::n_views == 2,
      "buffer bindings here must cover every view visit_views enumerates");
  device void* ptrs[2] = {b1, b2};
  threadgroup Shared shared;
  threadgroup float reduce_scratch[TMOL_N_SIMDS];
  Ctx ctx = tmol::score::common::mps_build_ctx<Ctx>(
      ptrs, meta);
  Lane lane(tid, n_threads, reduce_scratch);
  pose_total_reduce_body<
      DeviceOperations,
      tmol::Device::MPS,
      float,
      launch_t::sm_ptx::nt>(ctx, shared, int(cta), lane);
}
