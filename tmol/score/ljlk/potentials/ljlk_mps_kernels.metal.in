// Metal entry points for the LJ/LK term.
//
// Pre-expanded by the C preprocessor at build time and compiled at runtime;
// see cmake/TmolMetalShader.cmake. The scoring itself lives in
// ljlk_kernels.hh, compiled here from exactly the same source the CPU and
// CUDA backends use. All this file does is what Metal demands a kernel entry
// do and a called function cannot: declare the threadgroup storage, read the
// thread's position from entry attributes, and name the address space of the
// bound buffers.
//
// The view buffers are declared positionally and collected into an array:
// LJLKCtxT::visit_views assigns them to fields in this order, and the host
// binds them in that same order, so neither side repeats the field list.

#include <tmol/score/common/device_operations.mps.impl.hh>
#include <tmol/score/common/launch_box_macros.hh>
#include <tmol/score/ljlk/potentials/ljlk_ctx_metal.hh>
#include <tmol/score/ljlk/potentials/ljlk_kernels.hh>

using tmol::score::common::DeviceOperations;
using tmol::score::common::WorkgroupLane;
using namespace tmol::score::ljlk::potentials;

LAUNCH_BOX_32

typedef WorkgroupLane<tmol::Device::MPS> Lane;
typedef LJLKCtxMetal<float, int32_t, 4> PoseCtx;
typedef LJLKCtxMetal<float, int32_t, 2> RotCtx;
typedef LJLKSharedMem<float, TILE_SIZE, MAX_N_CONN, launch_t> LJLKShared;

#define TMOL_N_SIMDS ((launch_t::sm_ptx::nt + 31) / 32)

#define TMOL_LJLK_ENTRY(ENTRY_NAME, BODY, CTX_T)                             \
  kernel void ENTRY_NAME(                                                    \
      device const int64_t* meta [[buffer(0)]],                              \
      device void* b1 [[buffer(1)]],                                        \
      device void* b2 [[buffer(2)]],                                        \
      device void* b3 [[buffer(3)]],                                        \
      device void* b4 [[buffer(4)]],                                        \
      device void* b5 [[buffer(5)]],                                        \
      device void* b6 [[buffer(6)]],                                        \
      device void* b7 [[buffer(7)]],                                        \
      device void* b8 [[buffer(8)]],                                        \
      device void* b9 [[buffer(9)]],                                        \
      device void* b10 [[buffer(10)]],                                      \
      device void* b11 [[buffer(11)]],                                      \
      device void* b12 [[buffer(12)]],                                      \
      device void* b13 [[buffer(13)]],                                      \
      device void* b14 [[buffer(14)]],                                      \
      device void* b15 [[buffer(15)]],                                      \
      device void* b16 [[buffer(16)]],                                      \
      device void* b17 [[buffer(17)]],                                      \
      device void* b18 [[buffer(18)]],                                      \
      device void* b19 [[buffer(19)]],                                      \
      device void* b20 [[buffer(20)]],                                      \
      device void* b21 [[buffer(21)]],                                      \
      device void* b22 [[buffer(22)]],                                      \
      device void* b23 [[buffer(23)]],                                      \
      uint cta [[threadgroup_position_in_grid]],                             \
      uint tid [[thread_position_in_threadgroup]],                           \
      uint n_threads [[threads_per_threadgroup]]) {                          \
    static_assert(                                                           \
        CTX_T::n_views == 23,                                                \
        "buffer bindings here must cover every view visit_views enumerates");\
    device void* ptrs[23] = {b1, b2, b3, b4, b5, b6, b7, b8, b9, b10, b11, b12, b13, b14, b15, b16, b17, b18, b19, b20, b21, b22, b23};                                           \
    threadgroup LJLKShared shared;                                           \
    threadgroup float reduce_scratch[TMOL_N_SIMDS];                          \
    CTX_T ctx = tmol::score::common::mps_build_ctx<CTX_T>(ptrs, meta);                     \
    Lane lane(tid, n_threads, reduce_scratch);                               \
    /* The CPU-only per-pose accumulator has no counterpart here; an int      \
       keeps the parameter dependent so `if constexpr` discards its branch */ \
    BODY<DeviceOperations, tmol::Device::MPS, float, int32_t, launch_t>(      \
        ctx, shared, int(cta), 0, lane);                                     \
  }

TMOL_LJLK_ENTRY(
    ljlk_eval_energies_by_block_f32, ljlk_eval_energies_by_block, PoseCtx)
TMOL_LJLK_ENTRY(ljlk_eval_energies_f32, ljlk_eval_energies, PoseCtx)
TMOL_LJLK_ENTRY(
    ljlk_eval_rotamer_energies_by_block_f32,
    ljlk_eval_rotamer_energies_by_block,
    RotCtx)
