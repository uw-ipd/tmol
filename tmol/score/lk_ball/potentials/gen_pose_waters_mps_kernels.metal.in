// Metal entry point for LK-ball water generation.
//
// Pre-expanded by the C preprocessor at build time and compiled at runtime;
// see cmake/TmolMetalShader.cmake. The water building itself lives in
// gen_pose_waters_kernels.hh, compiled here from exactly the same source the
// CPU and CUDA backends use.
//
// Thirty view buffers plus the metadata buffer is 31 bindings, which is the
// per-kernel limit on Apple GPUs. Adding a view to WaterGenCtxT means packing
// several of the small per-block-type tables into one buffer first.

#include <tmol/score/common/device_operations.mps.impl.hh>
#include <tmol/score/common/launch_box_macros.hh>
#include <tmol/score/lk_ball/potentials/gen_pose_waters_ctx.hh>
#include <tmol/score/common/mps_ctx_builder.hh>
#include <tmol/utility/portable/metal_view.hh>
#include <tmol/score/lk_ball/potentials/gen_pose_waters_kernels.hh>

using tmol::score::common::DeviceOperations;
using tmol::score::common::WorkgroupLane;
using namespace tmol::score::lk_ball::potentials;

LAUNCH_BOX_32

typedef WorkgroupLane<tmol::Device::MPS> Lane;
typedef WaterGenCtxT<tmol::portable::MetalView, float, int32_t> WaterCtx;
typedef WaterGenDerivCtxT<tmol::portable::MetalView, float, int32_t> WaterDerivCtx;

#define TMOL_N_SIMDS ((launch_t::sm_ptx::nt + 31) / 32)

kernel void water_gen_build_waters_f32(
    device const int64_t* meta [[buffer(0)]],
    device void* b1 [[buffer(1)]],
    device void* b2 [[buffer(2)]],
    device void* b3 [[buffer(3)]],
    device void* b4 [[buffer(4)]],
    device void* b5 [[buffer(5)]],
    device void* b6 [[buffer(6)]],
    device void* b7 [[buffer(7)]],
    device void* b8 [[buffer(8)]],
    device void* b9 [[buffer(9)]],
    device void* b10 [[buffer(10)]],
    device void* b11 [[buffer(11)]],
    device void* b12 [[buffer(12)]],
    device void* b13 [[buffer(13)]],
    device void* b14 [[buffer(14)]],
    device void* b15 [[buffer(15)]],
    device void* b16 [[buffer(16)]],
    device void* b17 [[buffer(17)]],
    device void* b18 [[buffer(18)]],
    device void* b19 [[buffer(19)]],
    device void* b20 [[buffer(20)]],
    device void* b21 [[buffer(21)]],
    device void* b22 [[buffer(22)]],
    device void* b23 [[buffer(23)]],
    device void* b24 [[buffer(24)]],
    device void* b25 [[buffer(25)]],
    device void* b26 [[buffer(26)]],
    device void* b27 [[buffer(27)]],
    device void* b28 [[buffer(28)]],
    device void* b29 [[buffer(29)]],
    device void* b30 [[buffer(30)]],
    uint cta [[threadgroup_position_in_grid]],
    uint tid [[thread_position_in_threadgroup]],
    uint n_threads [[threads_per_threadgroup]]) {
  static_assert(
      WaterCtx::n_views == 30,
      "buffer bindings here must cover every view visit_views enumerates");
  device void* ptrs[30] = {
      b1, b2, b3, b4, b5, b6, b7, b8, b9, b10, b11, b12, b13, b14,
      b15, b16, b17, b18, b19, b20, b21, b22, b23, b24, b25, b26,
      b27, b28, b29, b30};
  threadgroup WaterGenSharedData<float, TILE_SIZE> shared_m;
  threadgroup float reduce_scratch[TMOL_N_SIMDS];
  WaterCtx ctx = tmol::score::common::mps_build_ctx<WaterCtx>(ptrs, meta);
  Lane lane(tid, n_threads, reduce_scratch);
  water_gen_build_waters_for_rot<
      DeviceOperations,
      tmol::Device::MPS,
      float,
      int32_t,
      launch_t>(ctx, shared_m, int(cta), lane);
}

// Backward pass: one threadgroup per rotamer, as in the forward.
kernel void water_gen_build_water_derivs_f32(
    device const int64_t* meta [[buffer(0)]],
    device void* b1 [[buffer(1)]],
    device void* b2 [[buffer(2)]],
    device void* b3 [[buffer(3)]],
    device void* b4 [[buffer(4)]],
    device void* b5 [[buffer(5)]],
    device void* b6 [[buffer(6)]],
    device void* b7 [[buffer(7)]],
    device void* b8 [[buffer(8)]],
    device void* b9 [[buffer(9)]],
    device void* b10 [[buffer(10)]],
    device void* b11 [[buffer(11)]],
    device void* b12 [[buffer(12)]],
    device void* b13 [[buffer(13)]],
    device void* b14 [[buffer(14)]],
    device void* b15 [[buffer(15)]],
    device void* b16 [[buffer(16)]],
    device void* b17 [[buffer(17)]],
    device void* b18 [[buffer(18)]],
    device void* b19 [[buffer(19)]],
    device void* b20 [[buffer(20)]],
    device void* b21 [[buffer(21)]],
    device void* b22 [[buffer(22)]],
    device void* b23 [[buffer(23)]],
    device void* b24 [[buffer(24)]],
    device void* b25 [[buffer(25)]],
    device void* b26 [[buffer(26)]],
    device void* b27 [[buffer(27)]],
    device void* b28 [[buffer(28)]],
    device void* b29 [[buffer(29)]],
    uint cta [[threadgroup_position_in_grid]],
    uint tid [[thread_position_in_threadgroup]],
    uint n_threads [[threads_per_threadgroup]]) {
  static_assert(
      WaterDerivCtx::n_views == 29,
      "buffer bindings here must cover every view visit_views enumerates");
  device void* ptrs[29] = {b1, b2, b3, b4, b5, b6, b7, b8, b9, b10, b11, b12, b13, b14, b15, b16, b17, b18, b19, b20, b21, b22, b23, b24, b25, b26, b27, b28, b29};
  threadgroup WaterGenSharedData<float, TILE_SIZE> shared_m;
  threadgroup float reduce_scratch[TMOL_N_SIMDS];
  WaterDerivCtx ctx =
      tmol::score::common::mps_build_ctx<WaterDerivCtx>(ptrs, meta);
  Lane lane(tid, n_threads, reduce_scratch);
  water_gen_build_water_derivs_for_rot<
      DeviceOperations,
      tmol::Device::MPS,
      float,
      int32_t,
      launch_t>(ctx, shared_m, int(cta), lane);
}
