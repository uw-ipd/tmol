#!/usr/bin/env bash

set -euo pipefail
IFS=$'\n\t'

pushd "$(dirname "${BASH_SOURCE[0]}")/.." >/dev/null

echo "--- Build HTML docs"
export PYTHONPATH="$PWD${PYTHONPATH:+:$PYTHONPATH}"
if [[ -n "${SPHINXOPTS:-}" ]]; then
    make -C docs html SPHINXOPTS="$SPHINXOPTS"
else
    make -C docs html
fi

popd >/dev/null
