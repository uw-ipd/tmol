# Emit a header defining SYMBOL as a C string literal holding IN's contents,
# preceded by the metal_stdlib include that the stubbed-out one stood in for
# during flattening.
file(READ "${IN}" _text)
string(REPLACE "\\" "\\\\" _text "${_text}")
string(REPLACE "\"" "\\\"" _text "${_text}")
string(REPLACE "\n" "\\n\"\n\"" _text "${_text}")
file(WRITE "${OUT}"
"// Generated by cmake/EmbedMetalSource.cmake from a .metal.in. Do not edit.
#pragma once
inline constexpr char const* ${SYMBOL} =
\"#include <metal_stdlib>\\n\"
\"using namespace metal;\\n\"
\"${_text}\";
")
